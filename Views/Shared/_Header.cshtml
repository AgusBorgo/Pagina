
@using System.Security.Claims

<header>
	<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3"> 
		<div class="container-fluid mx-5">
			<a class="navbar-brand" asp-controller="Home" asp-action="Index">BORGO</a>
			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-toggle="#navbarSupportedContent"
			arial-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
				<samp class="navbar-toggler-icon"></samp>		
			</button>
			<div class="navbar-collapse collapse d-sm-inline-flex justify-content-between" id="navbarSupportedContent">
				<form class="form-check-inline mx-auto" asp-controller="Home" asp-action="Productos" method="get">
					<div class="input-group">
							<i class="fa-solid" fa-magnifying-glass> </i>
						
					</div>
				</form>
				<ul class="navbar-nav">
					<li class="nav-item">

						<a class="nav-link text-dark" asp-controller="Carrito" asp-action="Index">
							<i class="fa-solid fa-cart-shopping"></i> 
							<span class="badge badge-pill badge-danger bg-primary">
								@ViewBag.NumeroProductos
							</span>
						</a>
					</li>
					@if(User.Identity != null && User.Identity.IsAuthenticated)
					{
						string nombreUsuario = User.Identity.Name ?? "Desconocido";

						<li class="nav-item dropdown"> 
							<a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" arial-expanded="false">
								<i class="fa-regular fa-user">@nombreUsuario</i>
							</a>
							<ul class="dropdown-menu">
								<li>
									<a class="dropdown-item" asp-controller="Account" asp-action="Profile">
										<i class="fa-solid fa-user"></i> Perfil
									</a>
								</li>
								<li>
									<a class="dropdown-item" asp-controller="Account" asp-action="Logout">
										<i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión
									</a>
								</li>
								@if (User.IsInRole("Admin"))
								{
									<li>
										<a class="dropdown-item" asp-controller="Dashboard" asp-action="Index">
											<i class="fa-solid fa-tachometer-alt"></i> Dashboard
										</a>
									</li>
								}
							</ul>
						</li>
					} else
					{
					<li class="nav-item"> 
						<a class="nav-link" asp-controller="Account" asp-action="Login">
							<i class="fa-regular fa-user"></i>
						</a>
					</li>	
					}
				</ul>
		</div>
		</div>
	</nav>

</header>