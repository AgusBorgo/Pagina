@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="vacio">
    <p class="rotulo">Algo salió mal</p>
    <h1 class="titulo-pagina">Se rayó el disco</h1>
    <p>Hubo un problema al procesar tu pedido. Probá de nuevo en un rato.</p>
    @if (Model?.ShowRequestId == true)
    {
        <p class="text-muted"><small>Código de referencia: <code>@Model.RequestId</code></small></p>
    }
    <a class="boton boton--acento" asp-controller="Home" asp-action="Index">Volver al inicio</a>
</div>
