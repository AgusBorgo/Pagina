@* Mensajes de una sola vez (TempData) que se muestran arriba de cualquier página *@
@if (TempData["Mensaje"] is string mensaje)
{
    <div class="aviso aviso--ok @(ViewData["FullWidth"] is true ? "aviso--margen" : "")" role="status">
        <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
        <span>@mensaje</span>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="aviso aviso--error @(ViewData["FullWidth"] is true ? "aviso--margen" : "")" role="alert">
        <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
        <span>@error</span>
    </div>
}
