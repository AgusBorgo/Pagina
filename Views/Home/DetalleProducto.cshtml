@model Producto
@{
	ViewData["Title"] = "Detalle del Producto";
}
<div class="container">
    <nav arial-label="breadcrum">
        <ol class="breadcrumb" id="breadcrum-container">
        </ol>
    </nav>
    <h2 class="my-4">@Model.Nombre</h2>
    <div class="row">
        <div class="col-md-6">
			<img class="img-fluid" src="@Model.ImagenUrl" alt="@Model.Nombre" />
         </div>
        <div class="col-md-6">
			<p>@Model.Descripcion</p>
			<h4>Precio: @String.Format("{0:C}", Model.Precio)</h4>
			<h5>Categoría: @Model.Categoria</h5>
			<h5>Stock: @Model.Stock</h5>
			@if (Model.Stock < 1)
			{
				<div class="alert alert-danger" role="alert">
					<i class="fas fa-exclamation-circle"></i> Agotado
				</div>
			}
			else
			{
				<form method="post" action="@Url.Action("AgregarProductoDetalle")" class="d-flex">
					<input type="hidden" name="productoId" value="@Model.ProductoId" />
					< type="number" class="form-control mr-2" name="cantidad" value="1" min="1"
						   max="@Model.Stock"></>
					<button type="submit" class="btn btn-primary btn-block">
						<i class="fas fa-cart-plus"></i> Agregar al carrito
					</button>
				</form>
			}
        </div>
    </div>

</div>
@{
	string? controllerName = Context.GetRouteValue("controller") as string;
	string? actionName = Context.GetRouteValue("action") as string;
}

<script>
    var controllerName = '@controllerName';
    var actionName = '@actionName';
</script>