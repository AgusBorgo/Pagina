@model PaginaWeb.Models.Producto

@{
    ViewData["Title"] = "Detalle del Producto";
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb" id="breadcrumb-container">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Nombre</li>
        </ol>
    </nav>

    <h2 class="my-4">@Model.Nombre</h2>

    <div class="row">
        <div class="col-md-6">
            <img class="img-fluid" src="@Model.ImagenUrl" alt="@Model.Nombre" />
        </div>
        <div class="col-md-6">
            <p>@Model.Descripcion</p>
            <h4>Precio: @String.Format("{0:C}", Model.Precio)</h4>
            <h5>Categoría: @Model.Categoria?.Nombre</h5>

            @if (Model.Stock < 1)
            {
                <div class="alert alert-danger" role="alert">
                    <i class="fas fa-exclamation-circle"></i> Agotado
                </div>
            }
            else
            {
                <form method="post" action="@Url.Action("AgregarProductoDetalle", "Home")" class="d-flex">
                    <input type="hidden" name="id" value="@Model.ProductoId" />
                    <button type="submit" class="btn btn-primary btn-block">
                        <i class="fas fa-cart-plus"></i> Agregar al carrito
                    </button>
                </form>

            }
        </div>
    </div>
</div>

@{
    string? controllerName = Context.GetRouteValue("controller") as string;
    string? actionName = Context.GetRouteValue("action") as string;
}

<script>
    var controllerName = '@controllerName';
    var actionName = '@actionName';
</script>
