@using Microsoft.AspNetCore.Routing

@model List<Producto>
@{
    ViewData["Title"] = "Inicio";
}

<div class="container">
    <!-- Inicio > Productos > Electrónica > Auriculares -->
    <nav arial-label="breadcrum">
        <ol class="breadcrumb" id="breadcrum-container">

        </ol>
    </nav>
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                @foreach(var categoria in ViewBag.Categorias)
                {
                    <a href="@Url.Action("Productos", "Home", new { categoriaId = categoria.CategoriaId }) class="btn btn-outline-secondary btn-sm">@categoria.Nombre</a>
                }
            </div>
        </div>
    </div>
    <h2 class="my-4">Productos destacados</h2>
    <div class="row" id="productosContainer">
        @foreach(var producto in Model)
        {
            <div class="col-md-4 col-sm-6 mb-4 productoItem" data-categoria="@producto.Categoria">
                <div class="card h-100 d-grid">
                    <a href="@Url.Action("DetalleProductos", "Home", new{id = producto.ProductoId})">
                        <img class="card-img-top" src="@producto.ImagenUrl"/>
                    </a>

                    <div class="card-body">
                        @if (producto != null)
                        {
                            <h5 class="card-title text-center">
                                <a href='@Url.Action("DetalleProducto", "Home", new { id = producto.ProductoId })'>
                            </h5>
                        }
                        <p class="card-text">@producto.Descripcion</p>
                    </div>
                    <ul class="list-group list-group-flush text-center">
                        <li class="llist-group-item font-weight-bold"> @String.Format("{0:C}", producto.Precio)</li>
                    </ul>   
                    <div class="card-body mt-auto">
                        @if (producto.Stock < 1)
                        {
                            <div class="alert alert-danger" role="alert">
                                <i class="fas fa-exclamation-circle"></i> Agotado
                            </div>
                        } else
                        {
                            <form method="post" action="@Url.Action("AgregarProductoIndex")" class="d-flex">
                                <input type="hidden" name="id" value="@producto.ProductoId" />
                                <input type="number" class="form-control mr-2" name="cantidad" value="1" min="1"
                                max="@producto.Stock" />
                                <button type="submit" class="btn btn-outline-primary rounded-pill">
                                    <i class="fas fa-cart-plus"></i>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
@{
    
    string? controllerName = Context.GetRouteValue("controller") as string;
    string? actionName = Context.GetRouteValue("action") as string;
}

<script>
	var controllerName = '@controllerName';
    var actionName = '@actionName';
</script>

                               