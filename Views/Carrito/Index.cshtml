@model ProcederConCompraViewModel
@{
    ViewData["Title"] = "Carrito";
    var items = Model.Carrito.Items;
    bool logueado = User.Identity?.IsAuthenticated ?? false;
    bool hayFaltantes = items.Any(i => i.Producto == null || i.Producto.Stock < 1 || !i.Producto.Activo);
    int unidades = items.Sum(i => i.Cantidad);
}

<p class="rotulo">Tu compra</p>
<h1 class="titulo-pagina">Carrito</h1>

@if (!items.Any())
{
    <div class="vacio">
        <p>Tu carrito está vacío.</p>
        <a class="boton boton--acento" asp-controller="Home" asp-action="Productos">Ir al catálogo</a>
    </div>
}
else
{
    <div class="carrito">
        <ul class="carrito__lista">
            @foreach (var item in items)
            {
                var p = item.Producto;
                bool sinStock = p == null || p.Stock < 1 || !p.Activo;
                <li class="carrito__item">
                    <div class="carrito__tapa">
                        @if (!string.IsNullOrWhiteSpace(p?.ImagenUrl))
                        {
                            <img src="@p.ImagenUrl" alt="" />
                        }
                        else
                        {
                            <span class="sin-tapa"></span>
                        }
                    </div>
                    <div>
                        <p class="carrito__nombre">
                            <a asp-controller="Home" asp-action="DetallesProducto" asp-route-id="@item.ProductoId">@item.Nombre</a>
                        </p>
                        <p class="carrito__detalle">
                            @(p?.Artista) · @Formato.Precio(item.Precio) c/u
                            @if (sinStock)
                            {
                                <span class="etiqueta etiqueta--acento ms-1">Sin stock</span>
                            }
                        </p>
                        <div class="carrito__acciones">
                            @if (!sinStock)
                            {
                                <form asp-action="ActualizarCantidad" method="post">
                                    <input type="hidden" name="productoId" value="@item.ProductoId" />
                                    <label for="cant-@item.ProductoId" class="visually-hidden">Cantidad de @item.Nombre</label>
                                    <input id="cant-@item.ProductoId" class="entrada" type="number" name="cantidad"
                                           min="1" max="@(p!.Stock)" value="@item.Cantidad" />
                                    <button type="submit" class="boton-icono" aria-label="Actualizar cantidad de @item.Nombre">
                                        <i class="fa-solid fa-rotate" aria-hidden="true"></i>
                                    </button>
                                </form>
                            }
                            <form asp-action="EliminarProducto" method="post">
                                <input type="hidden" name="productoId" value="@item.ProductoId" />
                                <button type="submit" class="boton-icono" aria-label="Quitar @item.Nombre del carrito">
                                    <i class="fa-regular fa-trash-can" aria-hidden="true"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                    <span class="carrito__subtotal">@Formato.Precio(item.Subtotal)</span>
                </li>
            }
        </ul>

        <aside class="resumen" aria-label="Resumen de la compra">
            <h2>Resumen</h2>
            <div class="resumen__fila">
                <span>@unidades @(unidades == 1 ? "disco" : "discos")</span>
                <span>@Formato.Precio(Model.Carrito.Total)</span>
            </div>
            <div class="resumen__fila">
                <span>Envío</span>
                <span>A coordinar</span>
            </div>
            <div class="resumen__total">
                <span>Total</span>
                <span>@Formato.Precio(Model.Carrito.Total)</span>
            </div>

            @if (hayFaltantes)
            {
                <button type="button" class="boton boton--acento boton--ancho" disabled>Confirmar compra</button>
                <p class="resumen__nota">Quitá los discos sin stock para poder confirmar.</p>
            }
            else if (logueado)
            {
                <form asp-action="ConfirmarCompra" method="post">
                    <button type="submit" class="boton boton--acento boton--ancho">Confirmar compra</button>
                </form>
            }
            else
            {
                <a class="boton boton--acento boton--ancho" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Index", "Carrito")">
                    Iniciá sesión para comprar
                </a>
                <p class="resumen__nota">¿No tenés cuenta? <a asp-controller="Account" asp-action="Register">Creala en un minuto</a>.</p>
            }

            <form asp-action="VaciarCarrito" method="post" class="mt-3">
                <button type="submit" class="boton boton--peligro boton--ancho boton--chico">Vaciar carrito</button>
            </form>
        </aside>
    </div>
}
