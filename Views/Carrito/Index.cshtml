@model PaginaWeb.Models.ViewModel.ProcederConCompraViewModel


@{
    ViewData["Title"] = "Carrito de Compras";
}

<h2>Carrito de compras</h2>

@if (!Model.Carrito.Items.Any())
{
    <div class="alert alert-info">
        <p>No hay productos en el carrito!</p>
        <a href="@Url.Action("Index", "Home")" class="btn btn-primary">Volver a la tienda</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Precio</th>
                    <th>Cantidad</th>
                    <th>Total</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Carrito.Items)
                {
                    if (item.Producto != null)
                    {
                        <tr>
                            <td>@item.Producto.Nombre</td>
                            <td>
                                
                                
                                    <form asp-action="ActualizarCantidad" asp-controller="Carrito" method="post">
                                        <div class="input-group input-group-sm">
                                            <input type="number" name="cantidad" class="form-control" min="1" max="@item.Producto.Stock" value="@item.Cantidad" />
                                            <div class="input-group-append">
                                                <button type="submit" class="btn btn-primary">
                                                    <i class="fas fa-sync-alt"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <input type="hidden" name="productoId" value="@item.Producto.ProductoId" />
                                    </form>
                                
                            </td>
                            <td>@item.Precio</td>
                            <td>@item.Subtotal.ToString("C")</td>
                            <td>
                                <form asp-action="EliminarProducto" asp-controller="Carrito" method="post">
                                    <input type="hidden" name="productoId" value="@item.Producto.ProductoId" />
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-end font-weight-bold">Total:</td>
                    <td colspan="2" class="font-weight-bold">@Model.Carrito.Total.ToString("C")</td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="text-right">
        <form asp-controller="Carrito" asp-action="VaciarCarrito" method="post">
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash-alt"></i> Vaciar carrito
            </button>
        </form>
    </div>
}
