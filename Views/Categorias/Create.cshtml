@model Categoria
@{
    ViewData["Title"] = "Nuevo género · Administración";
}

<nav aria-label="Ubicación">
    <ol class="migas">
        <li><a asp-controller="Dashboard" asp-action="Index">Administración</a></li>
        <li><a asp-action="Index">Géneros</a></li>
        <li aria-current="page">Nuevo</li>
    </ol>
</nav>

<h1 class="titulo-pagina">Nuevo género</h1>

<form asp-action="Create" method="post" novalidate>
    <partial name="_FormularioGenero" model="Model" />
    <div class="admin-form__botones">
        <button type="submit" class="boton boton--acento">Crear género</button>
        <a class="boton boton--borde" asp-action="Index">Cancelar</a>
    </div>
</form>
