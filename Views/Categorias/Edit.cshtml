@model Categoria
@{
    ViewData["Title"] = "Editar género · Administración";
}

<nav aria-label="Ubicación">
    <ol class="migas">
        <li><a asp-controller="Dashboard" asp-action="Index">Administración</a></li>
        <li><a asp-action="Index">Géneros</a></li>
        <li aria-current="page">Editar</li>
    </ol>
</nav>

<h1 class="titulo-pagina">Editar género</h1>

<form asp-action="Edit" asp-route-id="@Model.CategoriaId" method="post" novalidate>
    <input type="hidden" asp-for="CategoriaId" />
    <partial name="_FormularioGenero" model="Model" />
    <div class="admin-form__botones">
        <button type="submit" class="boton boton--acento">Guardar cambios</button>
        <a class="boton boton--borde" asp-action="Index">Cancelar</a>
    </div>
</form>
