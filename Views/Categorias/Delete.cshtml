@model Categoria
@{
    ViewData["Title"] = "Eliminar género · Administración";
    int cantidad = Model.Productos.Count;
}

<div class="cuenta__caja" style="max-width: 640px;">
    <p class="rotulo">Confirmar</p>
    <h1 class="titulo-pagina">¿Eliminar “@Model.Nombre”?</h1>

    @if (cantidad > 0)
    {
        <div class="aviso aviso--error">
            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
            <span>Este género tiene @cantidad @(cantidad == 1 ? "disco" : "discos"). Pasalos a otro género antes de eliminarlo.</span>
        </div>
        <a class="boton boton--borde" asp-action="Index">Volver</a>
    }
    else
    {
        <form asp-action="Delete" asp-route-id="@Model.CategoriaId" method="post" class="admin-form__botones">
            <button type="submit" class="boton boton--peligro">Eliminar género</button>
            <a class="boton boton--borde" asp-action="Index">Cancelar</a>
        </form>
    }
</div>
