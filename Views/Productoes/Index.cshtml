@model List<Producto>
@{
    ViewData["Title"] = "Discos · Administración";
}

<nav aria-label="Ubicación">
    <ol class="migas">
        <li><a asp-controller="Dashboard" asp-action="Index">Administración</a></li>
        <li aria-current="page">Discos</li>
    </ol>
</nav>

<div class="admin-encabezado">
    <h1 class="titulo-pagina">Discos</h1>
    <a class="boton boton--acento" asp-action="Create"><i class="fa-solid fa-plus" aria-hidden="true"></i> Cargar disco</a>
</div>

<form class="catalogo__barra" asp-action="Index" method="get" role="search">
    <label for="busquedaAdmin" class="visually-hidden">Buscar por título o artista</label>
    <input id="busquedaAdmin" class="entrada" type="search" name="busqueda" value="@ViewBag.Busqueda" placeholder="Buscar por título o artista" />
    <button type="submit" class="boton boton--borde">Buscar</button>
</form>

@if (!Model.Any())
{
    <p class="vacio">No hay discos @(string.IsNullOrEmpty(ViewBag.Busqueda as string) ? "cargados todavía" : "que coincidan con la búsqueda").</p>
}
else
{
    <div class="table-responsive">
        <table class="tabla-simple">
            <thead>
                <tr>
                    <th scope="col"><span class="visually-hidden">Tapa</span></th>
                    <th scope="col">Disco</th>
                    <th scope="col">Género</th>
                    <th scope="col" class="num">Precio</th>
                    <th scope="col" class="num">Stock</th>
                    <th scope="col">Estado</th>
                    <th scope="col"><span class="visually-hidden">Acciones</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(p.ImagenUrl))
                            {
                                <img class="admin-miniatura" src="@p.ImagenUrl" alt="" loading="lazy" />
                            }
                        </td>
                        <td>
                            <strong>@p.Nombre</strong>
                            <div class="text-muted">@p.Artista @(p.Anio.HasValue ? $"· {p.Anio}" : "")</div>
                        </td>
                        <td>@p.Categoria?.Nombre</td>
                        <td class="num">@Formato.Precio(p.Precio)</td>
                        <td class="num">@p.Stock</td>
                        <td>
                            @if (!p.Activo)
                            {
                                <span class="etiqueta">Oculto</span>
                            }
                            else if (p.Stock < 1)
                            {
                                <span class="etiqueta etiqueta--acento">Sin stock</span>
                            }
                            else
                            {
                                <span class="etiqueta etiqueta--ok">A la venta</span>
                            }
                        </td>
                        <td>
                            <div class="admin-acciones">
                                <a class="boton-icono" asp-action="Edit" asp-route-id="@p.ProductoId" aria-label="Editar @p.Nombre"><i class="fa-solid fa-pen" aria-hidden="true"></i></a>
                                <a class="boton-icono" asp-action="Delete" asp-route-id="@p.ProductoId" aria-label="Eliminar @p.Nombre"><i class="fa-regular fa-trash-can" aria-hidden="true"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
