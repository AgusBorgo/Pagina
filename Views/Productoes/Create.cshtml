@model Producto
@{
    ViewData["Title"] = "Cargar disco · Administración";
}

<nav aria-label="Ubicación">
    <ol class="migas">
        <li><a asp-controller="Dashboard" asp-action="Index">Administración</a></li>
        <li><a asp-action="Index">Discos</a></li>
        <li aria-current="page">Cargar disco</li>
    </ol>
</nav>

<h1 class="titulo-pagina">Cargar disco</h1>

<form asp-action="Create" method="post" novalidate>
    <partial name="_FormularioDisco" model="Model" />
    <div class="admin-form__botones">
        <button type="submit" class="boton boton--acento">Guardar disco</button>
        <a class="boton boton--borde" asp-action="Index">Cancelar</a>
    </div>
</form>
