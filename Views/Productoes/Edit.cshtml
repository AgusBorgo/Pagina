@model Producto
@{
    ViewData["Title"] = "Editar disco · Administración";
}

<nav aria-label="Ubicación">
    <ol class="migas">
        <li><a asp-controller="Dashboard" asp-action="Index">Administración</a></li>
        <li><a asp-action="Index">Discos</a></li>
        <li aria-current="page">Editar</li>
    </ol>
</nav>

<div class="admin-encabezado">
    <h1 class="titulo-pagina">Editar disco</h1>
    <a class="link-flecha" asp-controller="Home" asp-action="DetallesProducto" asp-route-id="@Model.ProductoId" target="_blank">
        Ver en la tienda <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
    </a>
</div>

<form asp-action="Edit" asp-route-id="@Model.ProductoId" method="post" novalidate>
    <input type="hidden" asp-for="ProductoId" />
    <partial name="_FormularioDisco" model="Model" />
    <div class="admin-form__botones">
        <button type="submit" class="boton boton--acento">Guardar cambios</button>
        <a class="boton boton--borde" asp-action="Index">Cancelar</a>
    </div>
</form>
