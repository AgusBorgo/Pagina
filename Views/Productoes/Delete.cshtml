@model Producto
@{
    ViewData["Title"] = "Eliminar disco · Administración";
    bool tieneVentas = ViewBag.TieneVentas is true;
}

<nav aria-label="Ubicación">
    <ol class="migas">
        <li><a asp-controller="Dashboard" asp-action="Index">Administración</a></li>
        <li><a asp-action="Index">Discos</a></li>
        <li aria-current="page">Eliminar</li>
    </ol>
</nav>

<div class="cuenta__caja" style="max-width: 640px;">
    <p class="rotulo">Confirmar</p>
    <h1 class="titulo-pagina">¿Eliminar “@Model.Nombre”?</h1>
    <p>@Model.Artista · @Model.Categoria?.Nombre · @Formato.Precio(Model.Precio)</p>

    @if (tieneVentas)
    {
        <div class="aviso aviso--error">
            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
            <span>Este disco ya tiene ventas. Para no romper el historial de pedidos, se va a <strong>ocultar</strong> de la tienda en lugar de borrarse.</span>
        </div>
    }

    <form asp-action="Delete" asp-route-id="@Model.ProductoId" method="post" class="admin-form__botones">
        <button type="submit" class="boton boton--peligro">@(tieneVentas ? "Ocultar disco" : "Eliminar disco")</button>
        <a class="boton boton--borde" asp-action="Index">Cancelar</a>
    </form>
</div>
