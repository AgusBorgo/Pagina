@{
	ViewData["Title"] = "Iniciar sesion";
}

<div class="container bg-light p-4">
	@if (User.Identity != null && User.Identity.IsAuthenticated)
	{
		<p>Ya iniciaste sesion</p>
		<script>
			setTimeout(function() {
			window.location.href = '@Url.Action("Index", "Home")';
			}, 3000);
		</script>
	}
	else
	{
		<h2>Iniciar sesion</h2>
		<form method="post">
			<div class="form-group">
				<label for="email">Nombre de usuario</label>
				<input id="email" name="email" required type="text" class="form-control"></input>
			</div>
			<div class="form-group">
				<label for="contrasena">Contrasenia</label>
				<input id="contrasena" name="contrasena" required type="password" class="form-control"></input>
			</div>
			<button type="submit" class="btn btn-primary">Ingresar</button>
		</form>
		<br />
		<a class="btn btn-outline-primary mt-2" asp-controller="Account" asp-action="Register">Registrarse</a>
	}
</div>