@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="cuenta">
    <div class="cuenta__lado">
        <p class="rotulo">Tu cuenta</p>
        <h1 class="titulo-pagina">Iniciar sesión</h1>
        <p>Entrá para confirmar tus compras y ver el historial de tus pedidos.</p>
    </div>

    <div class="cuenta__caja">
        <form asp-action="Login" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="resumen-errores" role="alert"></div>
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="campo">
                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" autocomplete="email" autofocus />
                <span asp-validation-for="Email" class="campo__error"></span>
            </div>

            <div class="campo">
                <label asp-for="Contrasena"></label>
                <input asp-for="Contrasena" autocomplete="current-password" />
                <span asp-validation-for="Contrasena" class="campo__error"></span>
            </div>

            <button type="submit" class="boton boton--acento boton--ancho">Ingresar</button>
        </form>

        <p class="cuenta__pie">¿Todavía no tenés cuenta? <a asp-action="Register">Creá una</a></p>
    </div>
</div>
