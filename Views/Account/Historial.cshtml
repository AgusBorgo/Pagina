@model List<Pedido>
@{
    ViewData["Title"] = "Mis pedidos";
}

<p class="rotulo">Tu cuenta</p>
<h1 class="titulo-pagina">Mis pedidos</h1>

@if (!Model.Any())
{
    <div class="vacio">
        <p>Todavía no hiciste ningún pedido.</p>
        <a class="boton boton--acento" asp-controller="Home" asp-action="Productos">Explorar el catálogo</a>
    </div>
}
else
{
    <ul class="pedidos">
        @foreach (var pedido in Model)
        {
            var discos = pedido.PedidoDetalles
                .Select(d => d.Producto?.Nombre ?? "Disco no disponible")
                .ToList();
            int unidades = pedido.PedidoDetalles.Sum(d => d.Cantidad);

            <li class="pedido">
                <div>
                    <h2 class="pedido__numero">Pedido #@pedido.PedidoId</h2>
                    <p class="pedido__meta">
                        @Formato.FechaHora(pedido.FechaPedido) · @unidades @(unidades == 1 ? "disco" : "discos")
                        · <span class="etiqueta @(pedido.Estado == "Finalizado" ? "etiqueta--ok" : "")">@pedido.Estado</span>
                    </p>
                    <p class="pedido__discos">
                        @(string.Join(" · ", discos.Take(3)))@(discos.Count > 3 ? $" y {discos.Count - 3} más" : "")
                    </p>
                </div>
                <div class="pedido__lado">
                    <span class="pedido__total">@Formato.Precio(pedido.Total)</span>
                    <a class="boton boton--borde boton--chico" asp-action="DetallePedido" asp-route-id="@pedido.PedidoId">Ver detalle</a>
                </div>
            </li>
        }
    </ul>
}
