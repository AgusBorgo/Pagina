@model RegistroViewModel
@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="cuenta">
    <div class="cuenta__lado">
        <p class="rotulo">Tu cuenta</p>
        <h1 class="titulo-pagina">Crear cuenta</h1>
        <p>Con tu cuenta podés comprar discos y seguir tus pedidos. Tus datos solo se usan para el envío.</p>
    </div>

    <div class="cuenta__caja">
        <form asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="resumen-errores" role="alert"></div>

            <div class="fila-campos">
                <div class="campo">
                    <label asp-for="Nombre"></label>
                    <input asp-for="Nombre" autocomplete="given-name" />
                    <span asp-validation-for="Nombre" class="campo__error"></span>
                </div>
                <div class="campo">
                    <label asp-for="Apellido"></label>
                    <input asp-for="Apellido" autocomplete="family-name" />
                    <span asp-validation-for="Apellido" class="campo__error"></span>
                </div>
            </div>

            <div class="campo">
                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" autocomplete="email" />
                <span asp-validation-for="Email" class="campo__error"></span>
            </div>

            <div class="fila-campos">
                <div class="campo">
                    <label asp-for="Contrasena"></label>
                    <input asp-for="Contrasena" autocomplete="new-password" />
                    <div class="campo__ayuda">Mínimo 8 caracteres.</div>
                    <span asp-validation-for="Contrasena" class="campo__error"></span>
                </div>
                <div class="campo">
                    <label asp-for="ConfirmarContrasena"></label>
                    <input asp-for="ConfirmarContrasena" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmarContrasena" class="campo__error"></span>
                </div>
            </div>

            <div class="campo">
                <label asp-for="Telefono"></label>
                <input asp-for="Telefono" type="tel" autocomplete="tel" />
                <span asp-validation-for="Telefono" class="campo__error"></span>
            </div>

            <div class="campo">
                <label asp-for="Direccion">Dirección (opcional)</label>
                <input asp-for="Direccion" autocomplete="street-address" />
                <span asp-validation-for="Direccion" class="campo__error"></span>
            </div>

            <button type="submit" class="boton boton--acento boton--ancho">Crear cuenta</button>
        </form>

        <p class="cuenta__pie">¿Ya tenés cuenta? <a asp-action="Login">Iniciá sesión</a></p>
    </div>
</div>
