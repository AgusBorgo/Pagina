@model Pedido
@{
    ViewData["Title"] = $"Pedido #{Model.PedidoId} · Administración";
}

<nav aria-label="Ubicación">
    <ol class="migas">
        <li><a asp-controller="Dashboard" asp-action="Index">Administración</a></li>
        <li><a asp-action="Index">Pedidos</a></li>
        <li aria-current="page">#@Model.PedidoId</li>
    </ol>
</nav>

<div class="admin-encabezado">
    <div>
        <p class="rotulo">@Formato.FechaHora(Model.FechaPedido)</p>
        <h1 class="titulo-pagina">Pedido #@Model.PedidoId</h1>
    </div>
    <span class="etiqueta @(Model.Estado == "Finalizado" ? "etiqueta--ok" : "")">@Model.Estado</span>
</div>

@if (Model.Usuario != null)
{
    <div class="metrica mb-4">
        <span class="metrica__nombre">Cliente</span>
        <p class="mt-2 mb-1"><strong>@Model.Usuario.Nombre @Model.Usuario.Apellido</strong> · @Model.Usuario.Email · @Model.Usuario.Telefono</p>
        <p class="mb-0 text-muted">@(string.IsNullOrWhiteSpace(Model.Usuario.Direccion) ? "Sin dirección cargada" : Model.Usuario.Direccion)</p>
    </div>
}

<div class="table-responsive">
    <table class="tabla-simple">
        <thead>
            <tr>
                <th scope="col">Disco</th>
                <th scope="col" class="num">Precio</th>
                <th scope="col" class="num">Cantidad</th>
                <th scope="col" class="num">Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.PedidoDetalles)
            {
                <tr>
                    <td>
                        <strong>@(d.Producto?.Nombre ?? "Disco eliminado")</strong>
                        <div class="text-muted">@d.Producto?.Artista</div>
                    </td>
                    <td class="num">@Formato.Precio(d.PrecioUnitario)</td>
                    <td class="num">@d.Cantidad</td>
                    <td class="num">@Formato.Precio(d.Subtotal)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3">Total</td>
                <td class="num">@Formato.Precio(Model.Total)</td>
            </tr>
        </tfoot>
    </table>
</div>
