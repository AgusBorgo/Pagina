@model Cliente
@{
    ViewData["Title"] = "Eliminar usuario · Administración";
    int pedidos = Model.Pedidos.Count;
}

<div class="cuenta__caja" style="max-width: 640px;">
    <p class="rotulo">Confirmar</p>
    <h1 class="titulo-pagina">¿Eliminar a @Model.Nombre @Model.Apellido?</h1>
    <p>@Model.Email · @(Model.Rol?.Nombre ?? "Sin rol")</p>

    @if (pedidos > 0)
    {
        <div class="aviso aviso--error">
            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
            <span>Este usuario tiene @pedidos @(pedidos == 1 ? "pedido" : "pedidos"), que también se van a eliminar.</span>
        </div>
    }

    <form asp-action="Delete" asp-route-id="@Model.UsuarioId" method="post" class="admin-form__botones">
        <button type="submit" class="boton boton--peligro">Eliminar usuario</button>
        <a class="boton boton--borde" asp-action="Index">Cancelar</a>
    </form>
</div>
