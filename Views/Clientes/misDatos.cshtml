@model PaginaWeb.Models.Cliente

@{
    ViewData["Title"] = "Perfil del Cliente";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-user"></i> Perfil del Cliente
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Nombre:</label>
                            <p class="form-control-plaintext border-bottom">@Model.Nombre</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Apellido:</label>
                            <p class="form-control-plaintext border-bottom">@Model.Apellido</p>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Email:</label>
                            <p class="form-control-plaintext border-bottom">@Model.Email</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Teléfono:</label>
                            <p class="form-control-plaintext border-bottom">@Model.Telefono</p>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold">Dirección:</label>
                            <p class="form-control-plaintext border-bottom">
                                @if (!string.IsNullOrEmpty(Model.Direccion))
                                {
                                    @Model.Direccion
                                }
                                else
                                {
                                    <span class="text-muted">No especificada</span>
                                }
                            </p>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Rol:</label>
                            <p class="form-control-plaintext border-bottom">
                                @if (Model.Rol != null)
                                {
                                    @Model.Rol.Nombre
                                }
                                else
                                {
                                    <span class="text-muted">Cliente</span>
                                }
                            </p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Total de Pedidos:</label>
                            <p class="form-control-plaintext border-bottom">
                                <span class="badge bg-info">@Model.Pedidos.Count</span>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="card-footer d-flex justify-content-between">
                    <div>
                        <a href="@Url.Action("Edit", "Cliente", new { id = Model.UsuarioId })"
                           class="btn btn-warning">
                            <i class="fas fa-edit"></i> Editar Perfil
                        </a>
                    </div>
                    <div>
                        <a href="@Url.Action("Historial", "Cliente", new { id = Model.UsuarioId })"
                           class="btn btn-success">
                            <i class="fas fa-history"></i> Historial de Pedidos
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Opcional: agregar interactividad
        $(document).ready(function() {
            // Tooltip para botones
            $('[data-bs-toggle="tooltip"]').tooltip();
        });
    </script>
}