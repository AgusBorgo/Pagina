@model List<Cliente>
@{
    ViewData["Title"] = "Usuarios · Administración";
}

<nav aria-label="Ubicación">
    <ol class="migas">
        <li><a asp-controller="Dashboard" asp-action="Index">Administración</a></li>
        <li aria-current="page">Usuarios</li>
    </ol>
</nav>

<h1 class="titulo-pagina">Usuarios</h1>

<div class="table-responsive">
    <table class="tabla-simple">
        <thead>
            <tr>
                <th scope="col">Nombre</th>
                <th scope="col">Email</th>
                <th scope="col">Teléfono</th>
                <th scope="col">Rol</th>
                <th scope="col" class="num">Pedidos</th>
                <th scope="col"><span class="visually-hidden">Acciones</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td><strong>@c.Nombre @c.Apellido</strong></td>
                    <td>@c.Email</td>
                    <td>@c.Telefono</td>
                    <td>
                        <span class="etiqueta @(c.Rol?.Nombre == "Administrador" ? "etiqueta--acento" : "")">@(c.Rol?.Nombre ?? "Sin rol")</span>
                    </td>
                    <td class="num">@c.Pedidos.Count</td>
                    <td>
                        <div class="admin-acciones">
                            <a class="boton-icono" asp-action="Edit" asp-route-id="@c.UsuarioId" aria-label="Cambiar rol de @c.Nombre"><i class="fa-solid fa-user-gear" aria-hidden="true"></i></a>
                            <a class="boton-icono" asp-action="Delete" asp-route-id="@c.UsuarioId" aria-label="Eliminar a @c.Nombre"><i class="fa-regular fa-trash-can" aria-hidden="true"></i></a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
