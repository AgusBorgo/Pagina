@model UsuarioAdminViewModel
@{
    ViewData["Title"] = "Usuario · Administración";
}

<nav aria-label="Ubicación">
    <ol class="migas">
        <li><a asp-controller="Dashboard" asp-action="Index">Administración</a></li>
        <li><a asp-action="Index">Usuarios</a></li>
        <li aria-current="page">@Model.NombreCompleto</li>
    </ol>
</nav>

<div class="cuenta__caja" style="max-width: 640px;">
    <p class="rotulo">Usuario</p>
    <h1 class="titulo-pagina">@Model.NombreCompleto</h1>
    <p class="mb-1">@Model.Email · @Model.Telefono</p>
    <p class="text-muted">@(string.IsNullOrWhiteSpace(Model.Direccion) ? "Sin dirección cargada" : Model.Direccion)</p>

    <form asp-action="Edit" asp-route-id="@Model.UsuarioId" method="post" class="mt-4">
        <div class="campo">
            <label for="rolId">Rol</label>
            <select id="rolId" name="rolId" asp-items="ViewBag.Roles"></select>
            <div class="campo__ayuda">Los datos personales los edita cada usuario desde “Mis datos”.</div>
        </div>
        <div class="admin-form__botones">
            <button type="submit" class="boton boton--acento">Guardar rol</button>
            <a class="boton boton--borde" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>
