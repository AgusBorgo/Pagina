diff --git a/Views/Shared/_Mensajes.cshtml b/Views/Shared/_Mensajes.cshtml
new file mode 100644
index 0000000..ec69211
--- /dev/null
+++ b/Views/Shared/_Mensajes.cshtml
@@ -0,0 +1,15 @@
+@* Mensajes de una sola vez (TempData) que se muestran arriba de cualquier página *@
+@if (TempData["Mensaje"] is string mensaje)
+{
+    <div class="aviso aviso--ok @(ViewData["FullWidth"] is true ? "aviso--margen" : "")" role="status">
+        <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
+        <span>@mensaje</span>
+    </div>
+}
+@if (TempData["Error"] is string error)
+{
+    <div class="aviso aviso--error @(ViewData["FullWidth"] is true ? "aviso--margen" : "")" role="alert">
+        <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
+        <span>@error</span>
+    </div>
+}
