+.dropdown-menu { background-color: var(--fondo-elevado); border: 1px solid var(--linea-fuerte); border-radius: var(--radio); }
+.dropdown-item { color: var(--papel); display: flex; align-items: center; gap: 10px; min-height: 40px; }
+.dropdown-item:hover, .dropdown-item:focus { background-color: var(--fondo-tapa); color: var(--papel); }
+.dropdown-divider { border-top-color: var(--linea-fuerte); }
+
+.btn-primary { background-color: var(--acento); border-color: var(--acento); color: var(--fondo); font-weight: 700; }
+.btn-primary:hover, .btn-primary:focus { background-color: var(--acento-hover); border-color: var(--acento-hover); color: var(--fondo); }
+.btn-outline-primary { color: var(--acento); border-color: var(--acento); }
+.btn-outline-primary:hover { background-color: var(--acento); color: var(--fondo); }
+.btn-danger { background-color: var(--acento-oscuro); border-color: var(--acento-oscuro); }
+
+/* En el catálogo hay menos espacio por la columna de filtros */
+.grilla-discos--catalogo { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+@media (max-width: 767.98px) { .grilla-discos--catalogo { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+@media (max-width: 479.98px) { .grilla-discos--catalogo { grid-template-columns: 1fr; } }
+.catalogo__total a { color: var(--acento); }
